NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for previews/prelaunch; set true at build and runtime when launching.
# Canonical URLs are centrally configured in src/lib/seo/site.ts.
SEO_INDEXABLE=false
# Optional GA4 web stream ID. Empty disables analytics; rebuild after changing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OAuth 2.0 Web client ID from Google Cloud (public value)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
